# Логин и пароль для входа в админ-панель (/admin/login).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

# Секрет, которым подписывается cookie сессии. Задайте случайную строку:
#   head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
# Если поменять — все, кто был в панели, выйдут из неё.
ADMIN_SESSION_SECRET=

# Где приложение слушает. Прокси (Apache/nginx) должен ходить сюда же.
# Наружу порт открывать не нужно: 127.0.0.1 доступен только с самого сервера.
PITCHROOM_HOST=127.0.0.1
PITCHROOM_PORT=3000

# Каталог с данными (группы, оценки, загруженные PDF).
# По умолчанию — <каталог приложения>/.wrangler/state
#PITCHROOM_STATE_DIR=/opt/pitchroom/.wrangler/state
