[Unit]
Description=Pitchroom — защита и оценка презентаций
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pitchroom
EnvironmentFile=-/etc/pitchroom.env
ExecStart=/opt/pitchroom/start.sh
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pitchroom

[Install]
WantedBy=multi-user.target
